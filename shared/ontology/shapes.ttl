@prefix lm: <https://linkedmusic.ca/terms/preservation/> .
@prefix diamm: <https://linkedmusic.ca/graphs/diamm/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

lm:EvidenceShape a sh:NodeShape ;
    sh:targetClass lm:EvidenceObservation ;
    sh:nodeKind sh:IRI .

# Open shapes allow preserved raw evidence and unresolved flags. They validate
# the representation, not historical truth, JSON contents or source fidelity.
lm:DiammProvenanceShape a sh:NodeShape ;
    sh:targetClass diamm:SourceProvenanceObservation ;
    sh:targetObjectsOf diamm:sourceProvenance ;
    sh:class diamm:SourceProvenanceObservation ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:path [ sh:inversePath diamm:sourceProvenance ];
        sh:minCount 1; sh:maxCount 1; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path diamm:place; sh:minCount 1; sh:maxCount 1; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dcterms:source; sh:minCount 1; sh:maxCount 1; sh:equals diamm:place ] ;
    sh:property [ sh:path diamm:sourceField; sh:minCount 1; sh:maxCount 1;
        sh:datatype xsd:string; sh:pattern "^(city|region)$" ] ;
    sh:property [ sh:path diamm:sourceProvenanceJson; sh:maxCount 1;
        sh:datatype xsd:string; sh:minLength 1 ] ;
    sh:property [ sh:path diamm:uncertain; sh:maxCount 1; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path diamm:earliestYear; sh:maxCount 1; sh:datatype xsd:gYear ] ;
    sh:property [ sh:path diamm:latestYear; sh:maxCount 1; sh:datatype xsd:gYear ] ;
    sh:property [ sh:path diamm:validationFlag; sh:datatype xsd:string ] ;
    sh:xone (
        [ sh:property [ sh:path diamm:sourceProvenanceJson; sh:minCount 1 ];
          sh:not [ sh:property [ sh:path diamm:validationFlag;
              sh:hasValue "legacy-unqualified-provenance" ] ] ]
        [ sh:property [ sh:path diamm:sourceProvenanceJson; sh:maxCount 0 ];
          sh:property [ sh:path diamm:uncertain; sh:maxCount 0 ];
          sh:property [ sh:path diamm:earliestYear; sh:maxCount 0 ];
          sh:property [ sh:path diamm:latestYear; sh:maxCount 0 ];
          sh:property [ sh:path diamm:validationFlag;
              sh:hasValue "legacy-unqualified-provenance"; sh:maxCount 1 ] ]
    ) .

# Optional, deliberately separate from the current evidence-only profile.
# No shape requires invented lineage on existing observations.
lm:SnapshotShape a sh:NodeShape ;
    sh:targetClass lm:SourceSnapshot ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:path lm:sha256; sh:minCount 1; sh:maxCount 1;
        sh:datatype xsd:string; sh:pattern "^[0-9a-f]{64}$" ] .
lm:RecordVersionShape a sh:NodeShape ;
    sh:targetClass lm:SourceRecordVersion ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:path prov:wasDerivedFrom; sh:minCount 1; sh:maxCount 1;
        sh:class lm:SourceSnapshot; sh:node lm:SnapshotShape ] ;
    sh:property [ sh:path lm:recordSelector; sh:minCount 1; sh:maxCount 1;
        sh:datatype xsd:string; sh:minLength 1 ] .
lm:ManifestShape a sh:NodeShape ;
    sh:targetClass lm:RunManifest ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:path lm:sha256; sh:minCount 1; sh:maxCount 1;
        sh:datatype xsd:string; sh:pattern "^[0-9a-f]{64}$" ] .
lm:ConversionShape a sh:NodeShape ;
    sh:targetClass lm:Conversion ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:path lm:runManifest; sh:minCount 1; sh:maxCount 1;
        sh:class lm:RunManifest; sh:node lm:ManifestShape ] .
lm:OccurrenceShape a sh:NodeShape ;
    sh:targetClass lm:ObservationOccurrence ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:path prov:specializationOf; sh:minCount 1; sh:maxCount 1;
        sh:class lm:EvidenceObservation; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path prov:wasDerivedFrom; sh:minCount 1; sh:maxCount 1;
        sh:class lm:SourceRecordVersion; sh:node lm:RecordVersionShape ] ;
    sh:property [ sh:path prov:wasGeneratedBy; sh:minCount 1; sh:maxCount 1;
        sh:class lm:Conversion; sh:node lm:ConversionShape ] ;
    sh:sparql [
        sh:message "The generating conversion must explicitly use this source record version." ;
        sh:select """
            PREFIX prov: <http://www.w3.org/ns/prov#>
            SELECT $this WHERE {
                $this prov:wasGeneratedBy ?run; prov:wasDerivedFrom ?record .
                FILTER NOT EXISTS { ?run prov:used ?record }
            }
        """
    ] .
